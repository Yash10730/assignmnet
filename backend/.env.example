NODE_ENV=development
PORT=5000

# MongoDB connection string (local, Docker or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/helpdesk

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Initial admin account created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@helpdesk.com
ADMIN_PASSWORD=Admin@123

# Optional: SMTP for email notifications (if empty, emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Helpdesk <no-reply@helpdesk.com>"
